    "iqlabs-sdk": "npm:@iqlabs-official/solana-sdk@^0.1.25"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
